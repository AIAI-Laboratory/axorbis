{
  "name": "axorbis-literature-review",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop literature review workspace powered by SynthScholar",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "test": "python3 integration/run_tests.py",
    "desktop:dev": "npm run tauri:dev --prefix app",
    "desktop:check": "cargo fmt --check --manifest-path app/src-tauri/Cargo.toml && cargo check --locked --manifest-path app/src-tauri/Cargo.toml && cargo test --locked --manifest-path app/src-tauri/Cargo.toml",
    "desktop:build": "npm run tauri:build --prefix app"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@tauri-apps/plugin-opener": "^2.5.5",
    "katex": "^0.18.9",
    "marked": "^18.0.5"
  }
}
